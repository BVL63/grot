{
  "name": "grafik-otpuskov-2027",
  "version": "0.3.141",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "vite build --base=/grot/ && node scripts/copy-print-vendors.mjs && node scripts/generate-windows-icon.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build:desktop && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "vite": "^6.2.0",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2"
  },
  "main": "desktop/main.cjs",
  "description": "ГРОТ — график отпусков (веб и Windows)",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.34.4"
  },
  "build": {
    "appId": "ru.grot.vacation.desktop",
    "productName": "ГРОТ",
    "asar": true,
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ГРОТ",
      "artifactName": "GROT-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "GROT-Portable-${version}-${arch}.${ext}"
    }
  }
}
